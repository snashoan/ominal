<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp">
        <bitmap
            android:src="@drawable/gir_final_logo"
            android:gravity="fill"
            android:antialias="true"
            android:dither="true"
            android:filter="true" />
    </item>
    <item
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp">
        <bitmap
            android:src="@drawable/gir_final_logo_white"
            android:gravity="fill"
            android:antialias="true"
            android:dither="true"
            android:filter="true" />
    </item>
</layer-list>
